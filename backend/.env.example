# ==============================================================================
# QuickBizs Backend Environment Configuration Template
# Copy this file to .env and provide your actual values.
# NEVER commit .env with real credentials into source control.
# ==============================================================================

# Server Runtime Settings
PORT=5000
NODE_ENV=production

# ------------------------------------------------------------------------------
# Option A: Full MySQL Connection String (Recommended for Render / Cloud DBs)
# Example: mysql://user:password@host:port/database?ssl={"rejectUnauthorized":true}
# ------------------------------------------------------------------------------
DATABASE_URL="mysql://root:password@localhost:3306/quickbiz"

# ------------------------------------------------------------------------------
# Option B: Decomposed MySQL Credentials (Alternative if no full URI is provided)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=quickbiz
DB_SSL=false
DB_CONNECTION_LIMIT=10

# Security & Authentication (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# CORS Allowed Frontend Origin(s)
# Can be a single origin or comma-separated list of allowed URLs
FRONTEND_URL=https://your-frontend-app.onrender.com,http://localhost:5173

# Optional: Google Gemini AI Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
