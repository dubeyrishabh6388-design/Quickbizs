# ==============================================================================
# QuickBizs Frontend Environment Configuration Template
# Copy this file to .env or .env.production and set your values.
# In Render Static Site: configure these under "Environment Variables".
# ==============================================================================

# Backend API Root URL (No trailing slash)
# Local: http://localhost:5000
# Production: https://your-backend-api.onrender.com
VITE_API_URL=http://localhost:5000

# Application Branding & Environment Mode
VITE_APP_NAME=QuickBizs
VITE_APP_ENV=production

# Optional: Google Gemini AI API Key & Model (Client-side AI assistant)
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.6-flash
